# dockerfile.ga
# IMPORTANTE: Este Dockerfile deve ser construído a partir do diretório raiz do projeto
# Exemplo: docker build -f dockerfile.ga -t app-ga .
FROM python:3.13-slim

WORKDIR /app

# Copia módulo shared
COPY shared/ ./shared/

# Copia módulos do projeto
COPY scripts ./scripts
COPY ga ./ga
COPY integrations ./integrations
COPY load ./load
COPY app ./app
COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

ENV PYTHONUNBUFFERED=1
CMD ["python", "-u", "scripts/run_ga.py"]
